# Android Emulator can reach the Windows/macOS host through 10.0.2.2.
# For a physical Android phone on the same Wi-Fi, use the computer's LAN IP.
EXPO_PUBLIC_VOICE_TRANSPORT=webrtc
EXPO_PUBLIC_PIPECAT_URL=http://10.0.2.2:7860
EXPO_PUBLIC_MIITHII_API_URL=http://10.0.2.2:8787

# Production stays on SmallWebRTC. With an HTTPS Miithii API URL the app automatically
# mints a signed Voice capability; that response supplies the deployed Modal /start URL.
# EXPO_PUBLIC_VOICE_TRANSPORT=webrtc
# EXPO_PUBLIC_MIITHII_API_URL=https://api.miithii.in
