# Local SmallWebRTC development. Android Emulator reaches the host through 10.0.2.2;
# for a physical Android phone on the same Wi-Fi, use the computer's LAN IP.
EXPO_PUBLIC_PIPECAT_URL=http://10.0.2.2:7860
EXPO_PUBLIC_MIITHII_API_URL=http://10.0.2.2:8787

# Production-like Android validation uses the Cloudflare Realtime SFU. The API still mints
# the signed Miithii Voice capability; the explicit start URL keeps the Worker on its legacy
# route until the physical Android release gate passes.
# EXPO_PUBLIC_MIITHII_API_URL=https://api.miithii.in
# EXPO_PUBLIC_USE_VOICE_SESSION=true
# EXPO_PUBLIC_VOICE_TRANSPORT=cloudflare-sfu
# EXPO_PUBLIC_PIPECAT_START_URL=https://dhrubasumatary--miithii-voice-sfu-connect-app.modal.run/sfu/start
