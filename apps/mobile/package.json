{
  "name": "@miithii/mobile",
  "version": "0.0.1",
  "private": true,
  "main": "index.js",
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "@expo/dom-webview"
        ]
      },
      "ios": {
        "exclude": [
          "@expo/dom-webview"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@livekit/components-react": "2.9.21",
    "@livekit/react-native": "^3.0.0",
    "@livekit/react-native-expo-plugin": "^1.0.3",
    "@livekit/react-native-webrtc": "^144.2.0",
    "@miithii/language-core-ts": "workspace:*",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo": "^57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "livekit-client": "^2.22.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-view-shot": "5.1.0",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  }
}
