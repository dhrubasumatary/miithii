{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "miithii-voice",
  "main": "worker.js",
  "compatibility_date": "2026-09-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "voice.miithii.in/*", "zone_name": "miithii.in" }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "services": [{ "binding": "MIITHII_API", "service": "miithii-api" }],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true }
  }
}
