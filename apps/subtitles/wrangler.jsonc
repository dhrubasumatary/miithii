{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "miithii-subtitles",
  "main": "worker.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "subtitles.miithii.in", "custom_domain": true }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true }
  }
}
