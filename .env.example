# Shared API Worker
UPSTREAM_API_KEY=
SUPERMEMORY_API_KEY=

# Bodhan.AI — voice.miithii.in (apps/voice)
# https://console.bodhan.ai/api-docs/
BODHAN_API_KEY=
BODHAN_TTS_API_KEY=

# subtitles.miithii.in waitlist Worker
WAITLIST_KEY=

# chat.miithii.in — browser connects only to the Cloudflare API Worker
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_BASE_URL=https://api.miithii.in
# Assistant Cloud Frontend API URL (project id is encoded in the hostname)
NEXT_PUBLIC_ASSISTANT_BASE_URL=https://proj-00s8iick8y6c.assistant-api.com

# Local auth/API development uses the same-origin app proxies. Start
# workers/api locally so localhost Clerk azp/origins are accepted only in dev.
MIITHII_API_ORIGIN=http://127.0.0.1:8787
MIITHII_VOICE_API_ORIGIN=http://127.0.0.1:8788

