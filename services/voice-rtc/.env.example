# Media providers. These stay on the voice runtime; browsers never receive them.
BODHAN_API_KEY=
BODHAN_TTS_API_KEY=

# Miithii brain. Local development defaults to the local Cloudflare API worker.
MIITHII_API_URL=http://127.0.0.1:8787
MIITHII_DEV_NO_AUTH=true

# Preferred bridge: token returned by workers/api POST /api/voice/session.
MIITHII_VOICE_SESSION_TOKEN=
VOICE_RTC_TOKEN=

# Production SmallWebRTC relay. Create one Cloudflare Realtime TURN key and keep
# the long-lived key here/server-side only; clients receive expiring credentials.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

# Reply language controls Miithii's output only. User speech is auto-detected.
MIITHII_VOICE_LANGUAGE=as
