# Media providers. These stay on the voice runtime; browsers never receive them.
BODHAN_API_KEY=
BODHAN_TTS_API_KEY=

# Miithii brain. Local development defaults to the local Cloudflare API worker.
MIITHII_API_URL=http://127.0.0.1:8787
MIITHII_DEV_NO_AUTH=true

# Preferred bridge: token returned by workers/api POST /api/voice/session.
MIITHII_VOICE_SESSION_TOKEN=
VOICE_RTC_TOKEN=

# Cloudflare Realtime SFU. CALLS_* authorizes the server-side SFU proxy. The TURN key
# stays server-side and is used only to mint short-lived ICE credentials for clients;
# direct client-to-Modal TURN is not the production transport.
CALLS_APP_ID=
CALLS_APP_SECRET=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=

# Deployment identity. Production SFU deployments use the separate Modal app and stamp
# the exact git revision into /health.
MIITHII_MODAL_APP_NAME=miithii-voice-sfu
MIITHII_DEPLOY_REVISION=

# Reply language controls Miithii's output only. User speech is auto-detected.
MIITHII_VOICE_LANGUAGE=as
