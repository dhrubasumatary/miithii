# LiveKit connection. Read by LiveKit's own worker CLI; also used to register the agent.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# The agent name the phone dispatches to. The app must match this.
MIITHII_AGENT_NAME=miithii-voice

# LLM leg. Voice defaults to Gemini 2.5 Flash through AIMLAPI with reasoning disabled.
# `google` remains available only when direct Gemini is deliberately selected.
MIITHII_LLM_PROVIDER=aiml
MIITHII_LLM_MODEL=google/gemini-2.5-flash
MIITHII_REASONING_EFFORT=none

# Assamese Standard speech. Eleven v4 support landed in the official LiveKit plugin after the
# 1.8.3 PyPI release; keep the model/provider server-owned rather than sending these from Android.
ELEVEN_API_KEY=
MIITHII_ELEVEN_MODEL=eleven_v4_turbo
MIITHII_ELEVEN_AS_VOICE_ID=
GOOGLE_API_KEY=
AIMLAPI_API_KEY=
AIMLAPI_BASE_URL=https://api.aimlapi.com/v1

# Sarvam realtime STT. The active language pack supplies the immutable session code
# (`as-IN` or `brx-IN`). The installed LiveKit 1.8.3 plugin exposes `mode` and `stream_type`,
# but no realtime model/keyterms option, so there is no dead `SARVAM_STT_MODEL` setting here.
SARVAM_API_KEY=
SARVAM_MIN_SILENCE_MS=700
SARVAM_MIN_SPEECH_MS=200

# Silero VAD. This decides when the user INTERRUPTS the agent, which is a different question
# from when a turn ends, so the thresholds are tuned separately.
SILERO_MIN_SILENCE=0.35
SILERO_MIN_SPEECH=0.05

# Bodhan non-streaming TTS. Assamese and Bodo voices come from the language packs, not here.
BODHAN_API_KEY=
BODHAN_BASE_URL=https://api.bodhan.ai/v1
BODHAN_MODEL=indic-speak
BODHAN_MAX_RESPONSE_BYTES=8388608

# Endpointing bounds for a natural turn. Tune on real Assamese/Bodo speech.
MIITHII_MIN_ENDPOINTING_DELAY=0.6
MIITHII_MAX_ENDPOINTING_DELAY=2.5
# Assamese-only Standard route; Bodo stays on Bodhan. No inline provider tags are added.
MIITHII_ASSAMESE_TTS=bodhan
# Set to elevenlabs only after confirming an Assamese-native voice ID and listening to its sample.
