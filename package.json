{
  "name": "miithii",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "dev:all": "turbo dev --parallel",
    "dev:hub": "pnpm --dir apps/hub dev",
    "dev:subtitles": "pnpm --dir apps/subtitles dev",
    "dev:chat": "pnpm --dir apps/chat dev",
    "dev:voice": "pnpm --dir apps/voice dev",
    "typecheck": "turbo typecheck",
    "check": "pnpm typecheck && pnpm build",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "rimraf": "latest",
    "tailwindcss": "latest",
    "turbo": "latest",
    "typescript": "^5.9.2"
  }
}
