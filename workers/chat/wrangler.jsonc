{
  "name": "miithii-chat",
  "account_id": "66f97ccf87b3349218040db7b434e97d",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chat.miithii.in", "custom_domain": true }],
  "assets": {
    "directory": "../../apps/chat/out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "services": [{ "binding": "MIITHII_API", "service": "miithii-api" }],
  "observability": {
    "enabled": true,
    "logs": { "invocation_logs": true }
  }
}
