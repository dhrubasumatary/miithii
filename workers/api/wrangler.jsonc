{
  "name": "miithii-api",
  "account_id": "66f97ccf87b3349218040db7b434e97d",
  "main": "src/index.js",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.miithii.in", "custom_domain": true }],
  "vars": {
    "UPSTREAM_BASE_URL": "https://api.aimlapi.com/v1",
    "UPSTREAM_MODEL": "google/gemini-2.5-flash",
    "SUPERMEMORY_ROUTER_URL": "https://api.supermemory.ai/v3",
    "ALLOWED_ORIGIN": "https://chat.miithii.in"
  },
  "ratelimits": [{ "name": "CHAT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "durable_objects": { "bindings": [{ "name": "DAILY_QUOTA", "class_name": "DailyQuota" }] },
  "migrations": [{ "tag": "v2-anonymous-quota", "new_sqlite_classes": ["DailyQuota"] }],
  "observability": { "enabled": true, "logs": { "invocation_logs": true } }
}
