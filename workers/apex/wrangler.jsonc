{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "miithii-apex-fresh",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "miithii.in/*",
      "zone_name": "miithii.in"
    },
    {
      "pattern": "www.miithii.in/*",
      "zone_name": "miithii.in"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "../../apps/hub/out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
