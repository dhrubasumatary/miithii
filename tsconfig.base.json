{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "es2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@miithii/auth": ["packages/auth/src/index.ts"],
      "@miithii/billing": ["packages/billing/src/index.ts"],
      "@miithii/db": ["packages/db/src/index.ts"],
      "@miithii/llm-router": ["packages/llm-router/src/index.ts"],
      "@miithii/memory": ["packages/memory/src/index.ts"],
      "@miithii/ui": ["packages/ui/src/index.ts"],
      "@miithii/uploads": ["packages/uploads/src/index.ts"]
    }
  }
}

